<Project Sdk="Microsoft.NET.Sdk">

    <!-- Project Properties -->
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- NuGet Sources: BepInEx and UnityEngine.Modules are only on the BepInEx feed -->
    <PropertyGroup>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json
        </RestoreAdditionalProjectSources>
    </PropertyGroup>

    <!-- Embed Debug Symbols and hide local paths in stack traces -->
    <PropertyGroup>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>embedded</DebugType>
        <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>
    </PropertyGroup>
    <ItemGroup>
      <Content Remove="C:\Users\fabri\.nuget\packages\rune580.mods.lethalcompany.inpututils\0.7.13\contentFiles\any\netstandard2.1\en_US.json" />
      <Content Remove="C:\Users\fabri\.nuget\packages\rune580.mods.lethalcompany.inpututils\0.7.13\contentFiles\any\netstandard2.1\ru_RU.json" />
      <Content Remove="C:\Users\fabri\.nuget\packages\rune580.mods.lethalcompany.inpututils\0.7.13\contentFiles\any\netstandard2.1\zh_CN.json" />
    </ItemGroup>

    <!-- BepInEx and Game References: Lethal Company v81 (Unity 2022.3.62) -->
    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
        <PackageReference Include="LethalCompany.GameLibs.Steam" Version="81.0.5-ngd.0" PrivateAssets="all" />
    </ItemGroup>

    <!-- Mod Dependencies: keep these in sync with the versions installed in the test profiles -->
    <ItemGroup>
        <PackageReference Include="Evaisa.LethalLib" Version="1.2.0" PrivateAssets="all" />
        <PackageReference Include="Rune580.Mods.LethalCompany.InputUtils" Version="0.7.13" PrivateAssets="all" />
    </ItemGroup>

    <!--
    Netcode Patcher: runs the CLI pinned in .config/dotnet-tools.json after every build.
    The CLI is used instead of the MSBuild SDK because the SDK cannot load in Visual Studio 2022.
    -->
    <PropertyGroup>
        <NetcodePatcherUnityVersion>2022.3.62</NetcodePatcherUnityVersion>
        <NetcodePatcherNetcodeVersion>1.12.2</NetcodePatcherNetcodeVersion>
        <NetcodePatcherTransportVersion>1.0.0</NetcodePatcherTransportVersion>
    </PropertyGroup>

    <Target Name="NetcodePatch" AfterTargets="PostBuildEvent">
        <PropertyGroup>
            <NetcodePatcherDepsListFile>$(IntermediateOutputPath)ncp-deps.list</NetcodePatcherDepsListFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(NetcodePatcherDepsListFile)" Lines="@(ReferencePathWithRefAssemblies)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Exec Command="dotnet tool restore" StandardOutputImportance="low" />
        <Exec Command="dotnet tool run netcode-patch -uv $(NetcodePatcherUnityVersion) -nv $(NetcodePatcherNetcodeVersion) -tv $(NetcodePatcherTransportVersion) &quot;$(TargetPath)&quot; --dependency-file &quot;$(NetcodePatcherDepsListFile)&quot;" />
    </Target>

    <!-- Copy the built DLL to the test folders set in the .csproj.user file -->
    <Target Name="CopyToTestDirectories" AfterTargets="NetcodePatch">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityPluginDirectory)" Condition="'$(UnityPluginDirectory)' != ''" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProfilePluginDirectory)" Condition="'$(ProfilePluginDirectory)' != ''" />
    </Target>
</Project>
